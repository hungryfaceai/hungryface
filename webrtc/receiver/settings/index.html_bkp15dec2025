  <!-- PSK + Rooms bootstrap -->
  <script type="module">
    import { installPskShim } from '/hungryface/webrtc/shared/psk/psk-ws-shim.js';
    import { requirePskOrRedirect, listValidPskRooms } from '/hungryface/webrtc/shared/psk/require-psk.js';

    const roomSel = document.getElementById('roomSel');
    const statusEl = document.getElementById('status');

    // Ensure a PSK exists (redirects to pairing if none)
    const qs = new URLSearchParams(location.search);
    const preferRoom = (qs.get('room') || '').trim();
    const env = await requirePskOrRedirect({
      intent: 'viewer',
      pairRoute: '/hungryface/webrtc/pairpsk/',
      preferRoom,
      fallbackRoom: 'Baby',
    });

    if (!env.redirected) {
      const undo = installPskShim({ room: env.room });
      console.log('[PSK][receiver-settings] shim installed for room:', env.room);
    }

    function hasOption(sel, val) {
      return !!Array.from(sel?.options || []).find(o => o.value === val);
    }

    (function initRoomDropdown() {
      const rooms = listValidPskRooms();
      const qsRoom = new URLSearchParams(location.search).get('room') || '';
      const lastRoom = (localStorage.getItem('naptio:lastRoom') || '').trim();
      const persisted = (localStorage.getItem('bm_receiver_room') || '').trim();
      const envRoom = (env?.room || '').trim();

      const uniq = new Set(rooms);
      if (envRoom) uniq.add(envRoom);

      roomSel.innerHTML = '';
      if (uniq.size === 0) {
        roomSel.innerHTML = `<option value="" disabled selected>No PSK rooms</option>`;
        roomSel.disabled = true;
        statusEl.textContent = 'No paired rooms found. Pair devices to create a room.';
        return;
      }

      for (const r of Array.from(uniq).sort()) {
        const opt = document.createElement('option');
        opt.value = opt.textContent = r;
        roomSel.appendChild(opt);
      }

      const pick =
        (qsRoom && uniq.has(qsRoom) && qsRoom) ||
        (lastRoom && uniq.has(lastRoom) && lastRoom) ||
        (persisted && uniq.has(persisted) && persisted) ||
        envRoom ||
        Array.from(uniq)[0];

      roomSel.value = hasOption(roomSel, pick) ? pick : roomSel.options[0].value;

      try { localStorage.setItem('bm_receiver_room', roomSel.value); } catch {}
      try { localStorage.setItem('naptio:lastRoom', roomSel.value); } catch {}

      statusEl.textContent = `Active room: ${roomSel.value}`;

      roomSel.addEventListener('change', () => {
        try { localStorage.setItem('bm_receiver_room', roomSel.value); } catch {}
        try { localStorage.setItem('naptio:lastRoom', roomSel.value); } catch {}
        statusEl.textContent = `Active room: ${roomSel.value}`;
      });
    })();
  </script>

  <!-- ——— Alerts + In-app dashboard persistence & wiring ——— -->
  <script type="module">
    const KEYS = {
      audio: 'naptio:notify:audio',
      motion: 'naptio:notify:motion',
      fence: 'naptio:notify:fence',
      prone: 'naptio:notify:prone',
      cooldown: 'naptio:notifyCooldownMin',
      miniDash: 'naptio:miniDash:enabled'
    };

    function getOnOff(key, def = 'on') {
      const v = (localStorage.getItem(key) || '').toLowerCase();
      return (v === 'on' || v === 'off') ? v : def;
    }
    function setOnOff(key, val) {
      localStorage.setItem(key, (val === 'off') ? 'off' : 'on');
      try { localStorage.setItem('naptio:notify:ts', String(Date.now())); } catch {}
    }

    function wireSwitch(inputId, key, def = 'on') {
      const el = document.getElementById(inputId);
      el.checked = getOnOff(key, def) === 'on';
      el.addEventListener('change', () => setOnOff(key, el.checked ? 'on' : 'off'));
    }

    /* Default ON for all switches (including In-app dashboard) */
    wireSwitch('sw-audio', KEYS.audio, 'on');
    wireSwitch('sw-motion', KEYS.motion, 'on');
    wireSwitch('sw-fence', KEYS.fence, 'on');
    wireSwitch('sw-prone', KEYS.prone, 'on');
    wireSwitch('sw-miniDash', KEYS.miniDash, 'on');

    // Cooldown (minutes) — default to 1 if nothing saved
    const cooldownInput = document.getElementById('notifCooldownMin');
    const saved = parseInt(localStorage.getItem(KEYS.cooldown), 10);
    cooldownInput.value = Number.isFinite(saved) ? saved : 1;

    function clampInt(n, lo, hi) {
      n = Math.round(Number(n) || 0);
      return Math.min(hi, Math.max(lo, n));
    }

    const persistCooldown = () => {
      const v = clampInt(cooldownInput.value, 0, 999);
      cooldownInput.value = v;
      localStorage.setItem(KEYS.cooldown, String(v));
      try { localStorage.setItem('naptio:notify:ts', String(Date.now())); } catch {}
    };

    cooldownInput.addEventListener('change', persistCooldown);
    cooldownInput.addEventListener('blur', persistCooldown);
    cooldownInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { e.preventDefault(); persistCooldown(); }
    });
  </script>
