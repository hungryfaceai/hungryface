<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
  <title>Naptio – Support Email (Drop‑in)</title>
  <style>
    :root { color-scheme: dark; }
    html, body { margin: 0; height: 100%; background: #000; color: #eee; font-family: -apple-system, system-ui, Segoe UI, Roboto, Helvetica, Arial, sans-serif; }

    /* Demo page wrapper (you can remove) */
    .demo-wrap { display: grid; place-items: center; min-height: 100dvh; padding: 32px; }

    /* Overlay + bottom sheet */
    .overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(2px); opacity: 0; pointer-events: none; transition: opacity .2s ease; z-index: 60; }
    .overlay.active { opacity: 1; pointer-events: auto; }
    .sheet { position: fixed; inset-inline: 0; bottom: 0; transform: translateY(100%); transition: transform .26s ease; z-index: 61; }
    .sheet.active { transform: translateY(0); }
    .sheet .panel { margin: 0 auto; max-width: 720px; background: #111; color: #eee; border-radius: 24px 24px 0 0; box-shadow: 0 -10px 30px rgba(0,0,0,.5); padding: env(safe-area-inset-top) 16px calc(16px + env(safe-area-inset-bottom)); }
    .drag-handle { width: 44px; height: 5px; border-radius: 999px; background: #2a2a2a; margin: 10px auto 16px; }

    /* Form */
    .row { display: grid; gap: 8px; margin: 12px 12px; }
    .row.inline { grid-template-columns: 1fr 1fr; gap: 12px; }
    label { font-size: 13px; color: #bdbdbd; }
    select, input[type="email"], textarea { width: 100%; box-sizing: border-box; background: #161616; color: #eee; border: 1px solid #2a2a2a; border-radius: 14px; padding: 12px 14px; font-size: 15px; outline: none; }
    select:focus, input[type="email"]:focus, textarea:focus { border-color: #3a3a3a; box-shadow: 0 0 0 2px rgba(255,255,255,0.05) inset; }
    textarea { min-height: 120px; resize: vertical; }

    /* Drop zone */
    .dropzone { border: 1.5px dashed #2d2d2d; background: #121212; border-radius: 16px; padding: 16px; text-align: center; transition: border-color .15s ease, background .15s ease; }
    .dropzone.over { border-color: #4a4a4a; background: #151515; }
    .dropzone p { margin: 0; color: #bdbdbd; font-size: 14px; }
    .thumbs { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
    .chip { display: inline-flex; align-items: center; gap: 8px; background: #1a1a1a; border: 1px solid #2a2a2a; border-radius: 999px; padding: 6px 10px; font-size: 13px; }
    .chip button { appearance: none; border: none; background: none; color: #bbb; font-size: 16px; line-height: 1; cursor: pointer; }
    .chip img { width: 18px; height: 18px; object-fit: cover; border-radius: 4px; }

    /* Buttons */
    .actions { display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-between; align-items: center; margin: 18px 12px 6px; }
    .btns { display: flex; flex-wrap: wrap; gap: 10px; }
    .btn { appearance: none; cursor: pointer; border: none; padding: 12px 18px; border-radius: 999px; font-weight: 600; box-shadow: 0 6px 16px rgba(0,0,0,0.25); }
    .btn-primary { background: #2b7cff; color: white; }
    .btn-ghost { background: transparent; color: #ccc; border: 1px solid #2a2a2a; }
    .btn-text { background: transparent; color: #bbb; padding-inline: 8px; }
    .btn:disabled { opacity: .5; cursor: not-allowed; }

    .title { font-size: clamp(18px, 2.8vw, 20px); font-weight: 700; margin: 0 12px; }
    .desc { margin: 6px 12px 0; color: #9d9d9d; font-size: 14px; }

    /* Error text */
    .error { color: #ff8a80; font-size: 13px; margin: 8px 12px 0; display: none; }
    .error.show { display: block; }

    /* Desktop modal fallback */
    @media (min-width: 860px) {
      .sheet .panel { border-radius: 20px; margin-top: 10vh; }
      .sheet { inset: 0; display: grid; place-items: center; }
    }
  </style>
</head>
<body>
  <div class="demo-wrap">
    <button class="btn btn-primary" id="openSupport">Email Support (Demo)</button>
  </div>

  <!-- Support Sheet UI -->
  <div class="overlay" id="supportOverlay" aria-hidden="true"></div>
  <div class="sheet" id="supportSheet" role="dialog" aria-modal="true" aria-labelledby="supportTitle">
    <div class="panel">
      <div class="drag-handle" aria-hidden="true"></div>
      <h2 class="title" id="supportTitle">Email support</h2>
      <p class="desc">We usually respond within 1 business day.</p>

      <form id="supportForm" class="form" novalidate>
        <div class="row">
          <label for="topic">What do you need help with?</label>
          <select id="topic" required>
            <option value="Pairing">Pairing</option>
            <option value="Video/Audio">Video/Audio</option>
            <option value="Notifications">Notifications</option>
            <option value="Billing">Billing</option>
            <option value="Bug">Bug</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <div class="row">
          <label for="replyTo">Reply‑to email (optional)</label>
          <input id="replyTo" type="email" inputmode="email" autocomplete="email" placeholder="you@domain.com" />
        </div>

        <div class="row">
          <label for="message">Message</label>
          <textarea id="message" placeholder="Tell us what’s happening…" required></textarea>
        </div>

        <div class="row" id="attachmentsRow">
          <label>Attachments (optional)</label>
          <div id="dropzone" class="dropzone" tabindex="0" aria-label="Add files by dropping or choosing">
            <p>Drag & drop files here, or <button type="button" class="btn btn-text" id="pickFiles">browse</button></p>
            <input id="fileInput" type="file" multiple hidden />
            <div class="thumbs" id="thumbs"></div>
          </div>
        </div>

        <p class="error" id="errorText"></p>

        <div class="actions">
          <div class="btns">
            <button type="button" class="btn btn-primary" id="sendShare">Send via my Mail app</button>
            <button type="button" class="btn btn-ghost" id="sendEml">Create draft (.eml)</button>
            <button type="button" class="btn btn-ghost" id="openGmail">Open Gmail</button>
            <button type="button" class="btn btn-ghost" id="openOutlook">Open Outlook</button>
          </div>
          <button type="button" class="btn btn-text" id="copyAddress">Copy support@naptio.com</button>
        </div>
      </form>
    </div>
  </div>

  <script type="module">
  // ============================
  // Naptio Support Email (Drop-in)
  // ============================
  // Public API: installSupportEmail(opts) => { open({topic}), destroy }

  const DEFAULTS = {
    to: 'support@naptio.com',
    topics: ['Pairing','Video/Audio','Notifications','Billing','Bug','Other'],
    maxFiles: 5,
    maxPerFileBytes: 10 * 1024 * 1024,   // 10 MB
    maxTotalBytes: 20 * 1024 * 1024,     // 20 MB total
    diagnosticsEndpoint: '/api/support/collect',
    appContext: { page: location.pathname, version: '0.1.0' },
    getRecentLogs: null, // () => string[]
    onOpen: () => {}, onClose: () => {}, onHandoff: () => {}
  };

  export function installSupportEmail(userOpts = {}) {
    const opts = { ...DEFAULTS, ...userOpts };

    // Wire topics if custom
    const topicSel = document.getElementById('topic');
    if (userOpts.topics && Array.isArray(userOpts.topics)) {
      topicSel.innerHTML = '';
      for (const t of userOpts.topics) {
        const o = document.createElement('option'); o.value = t; o.textContent = t; topicSel.appendChild(o);
      }
    }

    const state = {
      files: [],
      totalBytes: 0,
      correlationId: genId(),
      canShareFiles: !!(navigator.canShare && navigator.canShare({ files: [new File([new Blob(['x'])], 'x.txt')] })),
    };

    // Elements
    const overlay = document.getElementById('supportOverlay');
    const sheet = document.getElementById('supportSheet');
    const form = document.getElementById('supportForm');
    const replyTo = document.getElementById('replyTo');
    const message = document.getElementById('message');
    const sendShareBtn = document.getElementById('sendShare');
    const sendEmlBtn = document.getElementById('sendEml');
    const openGmailBtn = document.getElementById('openGmail');
    const openOutlookBtn = document.getElementById('openOutlook');
    const copyAddressBtn = document.getElementById('copyAddress');
    const errorText = document.getElementById('errorText');
    const dropzone = document.getElementById('dropzone');
    const pickFilesBtn = document.getElementById('pickFiles');
    const fileInput = document.getElementById('fileInput');
    const thumbs = document.getElementById('thumbs');

    // Capability-driven UI
    if (!state.canShareFiles) {
      // Hide Share-with-files on platforms that can't do it
      sendShareBtn.style.display = 'none';
    }

    // Validation helpers
    function validate() {
      errorText.classList.remove('show');
      errorText.textContent = '';
      const msgOk = message.value.trim().length > 0;
      let ok = msgOk;

      // File size checks
      if (state.files.length) {
        if (state.files.length > opts.maxFiles) {
          showError(`Please attach up to ${opts.maxFiles} files.`); ok = false;
        }
        if (state.totalBytes > opts.maxTotalBytes) {
          showError(`Total attachments must be ≤ ${fmtBytes(opts.maxTotalBytes)}.`); ok = false;
        }
        for (const f of state.files) {
          if (f.size > opts.maxPerFileBytes) { showError(`${f.name} is larger than ${fmtBytes(opts.maxPerFileBytes)}.`); ok = false; break; }
        }
      }

      sendShareBtn.disabled = !ok;
      sendEmlBtn.disabled = !ok;
      openGmailBtn.disabled = !msgOk; // can send without files
      openOutlookBtn.disabled = !msgOk;
      return ok;
    }

    function showError(msg) { errorText.textContent = msg; errorText.classList.add('show'); }

    // Files handling
    pickFilesBtn.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', (e) => { addFiles([...e.target.files]); fileInput.value = ''; });

    ;['dragenter','dragover'].forEach(ev => dropzone.addEventListener(ev, (e) => { e.preventDefault(); e.stopPropagation(); dropzone.classList.add('over'); }));
    ;['dragleave','drop'].forEach(ev => dropzone.addEventListener(ev, (e) => { e.preventDefault(); e.stopPropagation(); dropzone.classList.remove('over'); }));
    dropzone.addEventListener('drop', (e) => {
      const files = [...(e.dataTransfer?.files || [])];
      addFiles(files);
    });

    function addFiles(files) {
      for (const f of files) {
        if (state.files.length >= opts.maxFiles) break;
        state.files.push(f);
      }
      state.totalBytes = state.files.reduce((a,b)=>a+b.size,0);
      renderThumbs();
      validate();
    }

    function removeFileAt(idx) {
      state.files.splice(idx,1);
      state.totalBytes = state.files.reduce((a,b)=>a+b.size,0);
      renderThumbs();
      validate();
    }

    function renderThumbs() {
      thumbs.innerHTML = '';
      state.files.forEach(async (file, idx) => {
        const chip = document.createElement('span'); chip.className = 'chip';
        // Thumbnail for images/videos when possible
        const thumb = document.createElement('img');
        try {
          if (file.type.startsWith('image/')) thumb.src = URL.createObjectURL(file);
        } catch {}
        if (thumb.src) chip.appendChild(thumb);
        const meta = document.createElement('span'); meta.textContent = `${file.name} • ${fmtBytes(file.size)}`; chip.appendChild(meta);
        const rm = document.createElement('button'); rm.type='button'; rm.setAttribute('aria-label','Remove'); rm.textContent='×'; rm.addEventListener('click',()=>removeFileAt(idx)); chip.appendChild(rm);
        thumbs.appendChild(chip);
      });
    }

    // Compose helpers
    function composeSubject() { return `[Naptio] ${topicSel.value}`; }
    function composeBody() {
      const lines = [];
      if (replyTo.value.trim()) lines.push(`Reply-to: ${replyTo.value.trim()}`);
      lines.push('');
      lines.push(message.value.trim());
      lines.push('');
      if (state.files.length) lines.push(`(Attachments: ${state.files.map(f=>f.name).join(', ')})`);
      return lines.join('\n');
    }

    // Actions
    sendShareBtn.addEventListener('click', async () => {
      if (!validate()) return;
      try {
        await postDiagnostics(); // fire-and-forget semantics inside
        const files = state.files;
        if (state.canShareFiles) {
          await navigator.share({ title: composeSubject(), text: composeBody(), files });
          opts.onHandoff({ method: 'web-share', correlationId: state.correlationId });
          close();
        }
      } catch (err) {
        showError('Unable to open Mail app. Try the .eml draft or web options.');
        console.warn('[support] share failed', err);
      }
    });

    sendEmlBtn.addEventListener('click', async () => {
      if (!validate()) return;
      try {
        await postDiagnostics();
        const eml = await buildEml({ to: opts.to, subject: composeSubject(), bodyText: composeBody(), files: state.files });
        const blob = new Blob([eml], { type: 'message/rfc822' });
        downloadBlob(blob, 'naptio-support.eml');
        opts.onHandoff({ method: 'eml-download', correlationId: state.correlationId });
        // keep sheet open so user can also use Gmail/Outlook if they prefer
      } catch (err) {
        showError('Could not create draft.');
        console.error('[support] eml build failed', err);
      }
    });

    openGmailBtn.addEventListener('click', async () => {
      if (!validate()) return;
      await postDiagnostics();
      const url = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(opts.to)}&su=${encodeURIComponent(composeSubject())}&body=${encodeURIComponent(composeBody())}`;
      window.open(url, '_blank', 'noopener');
      opts.onHandoff({ method: 'gmail', correlationId: state.correlationId });
    });

    openOutlookBtn.addEventListener('click', async () => {
      if (!validate()) return;
      await postDiagnostics();
      const url = `https://outlook.live.com/mail/0/deeplink/compose?to=${encodeURIComponent(opts.to)}&subject=${encodeURIComponent(composeSubject())}&body=${encodeURIComponent(composeBody())}`;
      window.open(url, '_blank', 'noopener');
      opts.onHandoff({ method: 'outlook', correlationId: state.correlationId });
    });

    copyAddressBtn.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(opts.to); copyAddressBtn.textContent = 'Copied!'; setTimeout(()=>copyAddressBtn.textContent = `Copy ${opts.to}`, 1200); } catch {}
    });

    // Open/Close controls + focus trap
    function open(preset = {}) {
      if (preset.topic && opts.topics.includes(preset.topic)) topicSel.value = preset.topic;
      overlay.classList.add('active');
      sheet.classList.add('active');
      sheet.setAttribute('aria-hidden','false');
      message.focus();
      opts.onOpen();
      document.addEventListener('keydown', onKeyDown);
      overlay.addEventListener('click', close);
    }

    function close() {
      overlay.classList.remove('active');
      sheet.classList.remove('active');
      sheet.setAttribute('aria-hidden','true');
      opts.onClose();
      document.removeEventListener('keydown', onKeyDown);
      overlay.removeEventListener('click', close);
    }

    function onKeyDown(e) {
      if (e.key === 'Escape') close();
    }

    validate();

    return { open, close, destroy: () => { overlay.remove(); sheet.remove(); } };

    // -------------- Helpers --------------
    function fmtBytes(n){ if (n<1024) return n+" B"; const u=['KB','MB','GB']; let i=-1; do{ n/=1024; i++; } while(n>=1024 && i<u.length-1); return n.toFixed(1)+' '+u[i]; }
    function genId(){ const a=new Uint8Array(8); crypto.getRandomValues(a); return [...a].map(b=>b.toString(16).padStart(2,'0')).join(''); }

    async function postDiagnostics(){
      try {
        if (!opts.diagnosticsEndpoint) return; // optional
        const snapshot = await collectDiagnostics({ correlationId: state.correlationId, appContext: opts.appContext, logs: await maybeGetLogs() });
        // Fire-and-forget
        fetch(opts.diagnosticsEndpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(snapshot) }).catch(()=>{});
      } catch (e) { console.warn('[support] diagnostics skipped', e); }
    }

    async function maybeGetLogs(){ try { return Array.isArray(opts.getRecentLogs?.()) ? opts.getRecentLogs() : []; } catch { return []; } }
  }

  // Install for demo button
  const widget = installSupportEmail();
  document.getElementById('openSupport').addEventListener('click', () => widget.open());

  // --------- Diagnostics snapshot (client) ---------
  async function collectDiagnostics({ correlationId, appContext, logs }){
    const nav = navigator;
    const ua = nav.userAgent || '';
    const hints = nav.userAgentData ? { brands: nav.userAgentData.brands, mobile: nav.userAgentData.mobile, platform: nav.userAgentData.platform } : null;
    const memory = 'deviceMemory' in nav ? nav.deviceMemory : undefined;
    const cores = 'hardwareConcurrency' in nav ? nav.hardwareConcurrency : undefined;
    const lang = nav.language;
    const vendor = nav.vendor;

    const screenInfo = { w: screen.width, h: screen.height, dpr: devicePixelRatio, orient: (screen.orientation && screen.orientation.type) || undefined };
    const viewport = { w: window.innerWidth, h: window.innerHeight };

    const conn = nav.connection ? { downlink: nav.connection.downlink, rtt: nav.connection.rtt, saveData: nav.connection.saveData, type: nav.connection.type } : null;

    let battery = null;
    try { if (nav.getBattery) { const b = await nav.getBattery(); battery = { charging: b.charging, level: b.level }; } } catch {}

    let camPerm, micPerm;
    try { if (navigator.permissions) { camPerm = (await navigator.permissions.query({ name: 'camera' })).state; } } catch {}
    try { if (navigator.permissions) { micPerm = (await navigator.permissions.query({ name: 'microphone' })).state; } } catch {}

    const time = { local: new Date().toISOString(), tz: Intl.DateTimeFormat().resolvedOptions().timeZone, offsetMin: -new Date().getTimezoneOffset() };

    // Minimal webrtc snapshot if present
    const webrtc = window.__naptioRtcSnapshot ? await window.__naptioRtcSnapshot() : null;

    return {
      correlationId,
      env: { ua, hints, platform: nav.platform, vendor, lang, memory, cores, screen: screenInfo, viewport, conn, battery, camPerm, micPerm, time },
      app: appContext || {},
      webrtc: webrtc || {},
      logs: Array.isArray(logs) ? logs.slice(-30) : []
    };
  }

  // --------- .eml Builder ---------
  async function buildEml({ to, subject, bodyText, files }){
    const boundary = '----naptio-' + Math.random().toString(36).slice(2);
    const headers = [
      `To: ${to}`,
      `Subject: ${mimeEncodeHeader(subject)}`,
      `Date: ${new Date().toUTCString()}`,
      `MIME-Version: 1.0`,
      `Content-Type: multipart/mixed; boundary="${boundary}"`
    ].join('\r\n');

    const parts = [];
    // Text part
    parts.push([
      `--${boundary}`,
      `Content-Type: text/plain; charset=UTF-8`,
      `Content-Transfer-Encoding: 7bit`,
      '',
      bodyText.replace(/\n/g,'\r\n')
    ].join('\r\n'));

    for (const file of files) {
      const bytes = new Uint8Array(await file.arrayBuffer());
      const b64 = base64Chunked(bytes);
      const safeName = file.name.replace(/[\r\n"]/g, '');
      const type = file.type || 'application/octet-stream';
      parts.push([
        `--${boundary}`,
        `Content-Type: ${type}; name="${safeName}"`,
        `Content-Transfer-Encoding: base64`,
        `Content-Disposition: attachment; filename="${safeName}"`,
        '',
        b64
      ].join('\r\n'));
    }

    parts.push(`--${boundary}--`);
    return headers + '\r\n\r\n' + parts.join('\r\n');
  }

  function mimeEncodeHeader(str) {
    // Simple UTF-8 Q encoding fallback when needed
    if (/[^\x20-\x7E]/.test(str)) {
      const utf8 = new TextEncoder().encode(str);
      let b64 = btoa(String.fromCharCode(...utf8));
      return `=?UTF-8?B?${b64}?=`;
    }
    return str;
  }

  function base64Chunked(uint8) {
    // Convert to base64 and wrap at 76 chars per RFC 2045
    let binary = '';
    const len = uint8.byteLength;
    for (let i=0; i<len; i++) binary += String.fromCharCode(uint8[i]);
    const b64 = btoa(binary);
    return b64.replace(/.{1,76}/g, '$&\r\n').trim();
  }

  function downloadBlob(blob, filename){
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = filename; document.body.appendChild(a); a.click(); a.remove();
    setTimeout(()=>URL.revokeObjectURL(url), 1000);
  }
  </script>
</body>
</html>
